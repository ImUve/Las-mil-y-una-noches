{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/api/(.*)",
      "methods": ["POST", "PATCH", "PUT", "DELETE"],
      "has": [{"type": "header", "key": "sec-fetch-site", "value": "same-origin"}],
      "dest": "https://mil-y-una-noches-uve-2026.jaxsbadof.chatgpt.site/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {"key": "origin"},
          "args": "https://mil-y-una-noches-uve-2026.jaxsbadof.chatgpt.site"
        }
      ]
    },
    {
      "src": "/api(?:/.*)?",
      "methods": ["POST", "PATCH", "PUT", "DELETE"],
      "status": 403,
      "headers": {"Cache-Control": "no-store"}
    },
    {
      "src": "/(.*)",
      "methods": ["GET", "HEAD", "OPTIONS"],
      "dest": "https://mil-y-una-noches-uve-2026.jaxsbadof.chatgpt.site/$1"
    },
    {"src": "/.*", "status": 405}
  ]
}
